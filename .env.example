CLIPSYNC_RELAY_URL=http://127.0.0.1:7600
# CLIPSYNC_HOME=/tmp/clipsync-home
# CLIPSYNC_NO_DAEMON=1

CLIPSYNC_RELAY_BIND=0.0.0.0:7600
CLIPSYNC_RELAY_PUBLIC_URL=http://127.0.0.1:7600
# Leave CLIPSYNC_RELAY_TOKEN_SECRET unset or blank for a fresh random key at startup.
# For a persistent key, generate one with: openssl rand -hex 32
# Set CLIPSYNC_RELAY_TOKEN_SECRET to that output (at least 32 bytes).
# CLIPSYNC_RELAY_WEBHOOK_URL=https://example.com/hooks/clipsync
# Generate a separate webhook key with: openssl rand -hex 32
# Set CLIPSYNC_RELAY_WEBHOOK_SECRET to that output to enable signed webhooks.
