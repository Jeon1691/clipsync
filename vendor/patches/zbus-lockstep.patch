     // zbus-lockstep will filter by appropriate direction and pick the first match.
     //
     // https://dbus.freedesktop.org/doc/dbus-specification.html#introspection-format
+    #[test]
+    fn rejects_malformed_xml_types_and_missing_interface_member_or_argument() {
+        use crate::error::LockstepError;
+        use std::io::Cursor;
+        let xml = r#"<node><interface name="org.example.Node"><signal name="Changed">
+            <arg name="value" type="s"/></signal></interface></node>"#;
+        assert!(matches!(
+            get_signal_body_type(Cursor::new(xml), "org.example.Other", "Changed", None),
+            Err(LockstepError::InterfaceNotFound(_))
+        ));
+        assert!(matches!(
+            get_signal_body_type(Cursor::new(xml), "org.example.Node", "Missing", None),
+            Err(LockstepError::MemberNotFound(_))
+        ));
+        assert!(matches!(
+            get_signal_body_type(Cursor::new(xml), "org.example.Node", "Changed", Some("missing")),
+            Err(LockstepError::ArgumentNotFound(_))
+        ));
+        let malformed = xml.replace("type=\"s\"", "type=\"(\"");
+        assert!(matches!(
+            get_signal_body_type(Cursor::new(malformed), "org.example.Node", "Changed", None),
+            Err(LockstepError::Xml(_))
+        ));
+    }
